# Copy to .env and fill in your details. NEVER commit .env.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Required, at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_HOURS=2
# Set to 1 if running behind a reverse proxy / load balancer
TRUST_PROXY=0

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=educ
