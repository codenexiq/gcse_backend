  "items": [
    {
      "kind": "lesson",
      "title": "The nth term",
      "subject": "maths",
      "level": "gcse",
      "topic": "tpbn046s",
      "blocks": [
        {
          "id": "b35dktw7",
          "type": "slide",
          "title": "Sequence basics",
          "body": "A sequence is an ordered list of numbers. Each number is a term, and its position is $n$.\n\nIn $5n + 2$, the first term is when $n = 1$: $5(1) + 2 = 7$."
        },
        {
          "id": "bpucvxzw",
          "type": "mcq",
          "question": "In the rule $5n + 2$, what does $n$ represent?",
          "options": [
            "The common difference",
            "The number of terms",
            "The position number",
            "The first term"
          ],
          "correct": 2,
          "explain": "$n$ is the position: 1st, 2nd, 3rd and so on."
        },
        {
          "id": "bjbim375",
          "type": "mcq",
          "question": "What is the 4th term of $5n + 2$?",
          "options": [
            "$20$",
            "$22$",
            "$27$",
            "$9$"
          ],
          "correct": 1,
          "explain": "Substitute $n = 4$: $5(4) + 2 = 22$."
        },
        {
          "id": "b08taqdm",
          "type": "written",
          "question": "Is $52$ a term in the sequence $5n + 2$? Show how you know.",
          "markScheme": "1 mark: sets up 5n + 2 = 52. 1 mark: n = 10. 1 mark: concludes yes, it is the 10th term.",
          "marks": 3
        }
      ],
      "id": "izbs3hko",
      "published": true,
      "createdBy": "t1"
    },
    {
      "kind": "notes",
      "title": "Expanding brackets",
      "subject": "maths",
      "level": "gcse",
      "topic": "te0nlu4z",
      "blocks": [
        {
          "id": "bw7lrg93",
          "type": "slide",
          "title": "Single brackets",
          "body": "Multiply the term outside by every term inside.\n\n$3(x + 4) = 3x + 12$"
        },
        {
          "id": "bpjcw6p3",
          "type": "slide",
          "title": "Double brackets",
          "body": "Use a grid so every term meets every other term.\n\n$(x + 2)(x + 5) = x^2 + 7x + 10$"
        }
      ],
      "id": "ip1tq793",
      "published": true,
      "createdBy": "t1"
    },
    {
      "kind": "video",
      "title": "Squaring a bracket",
      "subject": "maths",
      "level": "gcse",
      "topic": "te0nlu4z",
      "blocks": [
        {
          "id": "b7w44qxv",
          "type": "video",
          "title": "Squaring brackets with the area model",
          "url": "",
          "note": "Watch the 6-minute video, pausing to try each example."
        },
        {
          "id": "b2u4pt7g",
          "type": "mcq",
          "question": "Which is equal to $(x + 5)^2$?",
          "options": [
            "$x^2 + 25$",
            "$x^2 + 10x + 25$",
            "$x^2 + 5x + 25$",
            "$2x + 10$"
          ],
          "correct": 1,
          "explain": "$(x + 5)(x + 5) = x^2 + 5x + 5x + 25$."
        }
      ],
      "id": "ivpmzixv",
      "published": true,
      "createdBy": "t1"
    },
    {
      "kind": "quiz",
      "title": "Simultaneous equations check",
      "subject": "maths",
      "level": "gcse",
      "topic": "to9guubt",
      "source": "Drive: Algebra/Sim eq worksheet.pdf",
      "blocks": [
        {
          "id": "bb066fx1",
          "type": "mcq",
          "question": "Solve $2x + y = 11$ and $x + y = 7$",
          "options": [
            "$x = 2,\\ y = 5$",
            "$x = 4,\\ y = 3$",
            "$x = 3,\\ y = 4$",
            "$x = 9,\\ y = -7$"
          ],
          "correct": 1,
          "explain": "Subtract: $x = 4$, so $y = 3$."
        },
        {
          "id": "b3bj8o5k",
          "type": "mcq",
          "question": "Solve $3x - y = 5$ and $x + y = 7$",
          "options": [
            "$x = 3,\\ y = 4$",
            "$x = 2,\\ y = 5$",
            "$x = 1,\\ y = 6$",
            "$x = 3,\\ y = 2$"
          ],
          "correct": 0,
          "explain": "Add: $4x = 12$, so $x = 3$ and $y = 4$."
        },
        {
          "id": "bp4d1ps8",
          "type": "written",
          "question": "Solve $3x + 2y = 16$ and $5x - 2y = 8$. Show your working.",
          "markScheme": "1 mark: adds to get 8x = 24. 1 mark: x = 3. 1 mark: y = 3.5.",
          "marks": 3
        }
      ],
      "id": "iy1mu7no",
      "published": true,
      "createdBy": "t1"
    },
    {
      "kind": "notes",
      "title": "Energy stores",
      "subject": "physics",
      "level": "gcse",
      "topic": "tpdqxg5x",
      "createdBy": "t2",
      "blocks": [
        {
          "id": "b0sehyyl",
          "type": "slide",
          "title": "The 8 energy stores",
          "body": "Kinetic, gravitational potential, elastic potential, thermal, chemical, magnetic, electrostatic and nuclear.\n\nEnergy is transferred between stores by heating, by forces, or by electric current."
        }
      ],
      "id": "i663f7qf",
      "published": true
    },
    {
      "kind": "quiz",
      "title": "Energy stores quiz",
      "subject": "physics",
      "level": "gcse",
      "topic": "tpdqxg5x",
      "createdBy": "t2",
      "blocks": [
        {
          "id": "bykamsk8",
          "type": "mcq",
          "question": "A ball is lifted onto a shelf. Which store increases?",
          "options": [
            "Kinetic",
            "Gravitational potential",
            "Thermal",
            "Nuclear"
          ],
          "correct": 1,
          "explain": "Lifting raises its height, so its gravitational potential store increases."
        },
        {
          "id": "bwankj5m",
          "type": "mcq",
          "question": "Calculate the kinetic energy of a $2$ kg ball at $3$ m/s using $E_k = \\frac{1}{2}mv^2$",
          "options": [
            "$3$ J",
            "$6$ J",
            "$9$ J",
            "$18$ J"
          ],
          "correct": 2,
          "explain": "$\\frac{1}{2} \\times 2 \\times 3^2 = 9$ J."
        }
      ],
      "id": "iir41chy",
      "published": true
    }
  ],
